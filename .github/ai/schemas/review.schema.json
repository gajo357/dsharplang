{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["headSha", "verdict", "blockers", "criteria"],
  "properties": {
    "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"enum": ["pass", "changes_required", "needs_decision"]},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "requiredEvidence"],
        "properties": {
          "criterion": {"type": "string"},
          "file": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "requiredEvidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC[1-9][0-9]*$"},
          "status": {"enum": ["pass", "fail"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
