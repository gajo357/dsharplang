module Prelude

fn andThen<A, B, E>(next: (A) -> Result<B, E>, value: Result<A, E>): Result<B, E> {
    match value {
        Result.Success(item) => next(item)
        Result.Error(error) => Result.Error(error)
    }
}

// Internal implementations selected by the public andThen symbol.
async fn __dsharp_result_andthen_async<A, B, E>(next: (A) -> Task<Result<B, E>>, value: Result<A, E>): Result<B, E> {
    match value
    {
        Result.Success(item) => await next(item)
        Result.Error(error) => Result.Error(error)
    }
}

async fn __dsharp_result_andthen_task<A, B, E>(next: (A) -> Result<B, E>, value: Task<Result<A, E>>): Result<B, E> {
    let resolved = await value
    match resolved
    {
        Result.Success(item) => next(item)
        Result.Error(error) => Result.Error(error)
    }
}

async fn __dsharp_result_andthen_task_async<A, B, E>(next: (A) -> Task<Result<B, E>>, value: Task<Result<A, E>>): Result<B, E> {
    let resolved = await value
    match resolved
    {
        Result.Success(item) => await next(item)
        Result.Error(error) => Result.Error(error)
    }
}

fn map<A, B, E>(transform: (A) -> B, value: Result<A, E>): Result<B, E> {
    match value {
        Result.Success(item) => Result.Success(transform(item))
        Result.Error(error) => Result.Error(error)
    }
}

// Internal implementation selected by the public map symbol for task inputs.
async fn __dsharp_result_map_task<A, B, E>(transform: (A) -> B, value: Task<Result<A, E>>): Result<B, E> {
    let resolved = await value
    match resolved
    {
        Result.Success(item) => Result.Success(transform(item))
        Result.Error(error) => Result.Error(error)
    }
}

fn mapError<A, B, E>(convert: (E) -> B, value: Result<A, E>): Result<A, B> {
    match value {
        Result.Success(item) => Result.Success(item)
        Result.Error(error) => Result.Error(convert(error))
    }
}

// Internal implementation selected by the public mapError symbol for task inputs.
async fn __dsharp_result_maperror_task<A, B, E>(convert: (E) -> B, value: Task<Result<A, E>>): Result<A, B> {
    let resolved = await value
    match resolved
    {
        Result.Success(item) => Result.Success(item)
        Result.Error(error) => Result.Error(convert(error))
    }
}

fn tap<A, E>(observe: (A) -> Unit, value: Result<A, E>): Result<A, E> {
    match value {
        // Match arms cannot yet contain a bare block. This branch keeps the
        // observation and the unchanged result in the same lexical scope.
        Result.Success(item) => if true {
            observe(item)
            value
        } else { value }
        Result.Error(error) => value
    }
}

// Internal implementation selected by the public tap symbol for task inputs.
async fn __dsharp_result_tap_task<A, E>(observe: (A) -> Unit, value: Task<Result<A, E>>): Result<A, E> {
    let resolved = await value
    match resolved
    {
        Result.Success(present) => if true {
            observe(present)
            resolved
        } else { resolved }
        Result.Error(error) => resolved
    }
}

fn tapError<A, E>(observe: (E) -> Unit, value: Result<A, E>): Result<A, E> {
    match value {
        Result.Success(item) => value
        Result.Error(error) => if true {
            observe(error)
            value
        } else { value }
    }
}

// Internal implementation selected by the public tapError symbol for task inputs.
async fn __dsharp_result_taperror_task<A, E>(observe: (E) -> Unit, value: Task<Result<A, E>>): Result<A, E> {
    let resolved = await value
    match resolved
    {
        Result.Success(item) => resolved
        Result.Error(error) => if true {
            observe(error)
            resolved
        } else { resolved }
    }
}
