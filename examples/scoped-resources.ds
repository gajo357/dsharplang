module Demo

// The compiler releases each resource at the end of its scope.
resource Cursor(value: int) {
    read(): int { value }
    release(): Unit { () }
}

// A braced scope releases cursor when the block finishes.
fn answer(): int {
    using cursor = Cursor(40) {
        cursor.read() + 2
    }
}

// A declaration releases cursor at the end of the enclosing block.
fn run(): int {
    using cursor = Cursor(40)
    cursor.read() + 2
}
